# docker compose 가 자동으로 읽는 파일입니다.  cp .env.example .env  후 값을 채우세요.
# (.env 는 git 에 올라가지 않습니다. Spring 은 .env 를 읽지 않으므로 IntelliJ 실행 시에는 실행 설정의 환경변수를 사용하세요.)

# JWT 서명 키 (필수) - 생성: openssl rand -base64 32
JWT_SECRET=

# Gemini API 키 (선택, 없으면 AI 기능은 키워드 규칙으로 대체)
GEMINI_API_KEY=

# Slack Incoming Webhook (선택, SLA 임박·초과 알림을 Slack 채널로도 받기)
SLACK_WEBHOOK_URL=

# SNS 로그인 (선택). 각 개발자 콘솔에 콜백 주소 http://localhost:3000/login/oauth2/code/{google|kakao|naver} 등록
# 값 앞뒤에 공백이 들어가지 않게 주의 (공백이 섞이면 제공자가 invalid_client 로 거부)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# DB 계정
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 데모 계정/샘플 데이터 생성 여부 (외부 공개 시 false)
SEED_DATA=true

# 노출 포트
WEB_PORT=3000
API_PORT=8081
DB_PORT=5433

# 프론트엔드(yh-fe) 저장소 경로 (기본: 이 폴더 옆의 ../yh-fe)
FRONTEND_PATH=../yh-fe
